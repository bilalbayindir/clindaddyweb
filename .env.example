# ---------------------------------------------------------------------------
# ClinDaddy website — environment variables
#
# Copy to `.env.local` and fill in. Nothing here is required for the site to
# build or run; the values below change behaviour rather than enabling it.
#
# Rule: only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never give a credential that prefix.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, Open Graph tags, and the sitemap.
# No trailing slash. Defaults to https://www.clindaddy.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.clindaddy.com

# PLACEHOLDER — the published contact address. Shown in the footer, on the
# contact page, and used as the mailto fallback when no provider is configured.
# Replace before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@clindaddy.com


# ---------------------------------------------------------------------------
# Contact form delivery (server-only)
#
# The form posts to /api/contact. That route delivers the message through the
# first provider below that is configured, and otherwise reports honestly that
# nothing was sent. Configure exactly one.
# ---------------------------------------------------------------------------

# Option A — forward the submission as JSON to any endpoint.
# CONTACT_WEBHOOK_URL=

# Option B — send the submission as email through Resend.
# CONTACT_FROM_EMAIL must be a verified sender on your Resend account.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=ClinDaddy <no-reply@clindaddy.com>
# CONTACT_TO_EMAIL=hello@clindaddy.com
